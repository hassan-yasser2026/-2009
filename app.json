{
  "expo": {
    "name": "ذاكر صح",
    "slug": "hasan_platform",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hasanplatform",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hasanplatform.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "3"
    },
    "android": {
      "package": "com.hasanplatform.app",
      "versionCode": 4,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1E3A8A"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 400,
          "resizeMode": "contain",
          "backgroundColor": "#1E3A8A"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f5b54208-40d7-4738-b5a3-1ab2f05c1098"
      }
    }
  }
}
