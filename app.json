{
  "expo": {
    "name": "منصة البشمهندس حسن",
    "slug": "hasan_platform",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hasanplatform",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hasanplatform.app"
    },
    "android": {
      "package": "com.hasanplatform.app",
      "adaptiveIcon": {
        "backgroundColor": "#1E3A8A"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}