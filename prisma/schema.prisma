generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  fullName       String
  email          String    @unique
  phone          String    @unique
  passwordHash   String
  gradeId        Int
  gradeName      String
  sectionId      String?
  sectionName    String?
  referralCode   String    @unique
  referredBy     String?
  referralCount  Int       @default(0)
  subscriptionEnd DateTime?
  status         String    @default("pending") // pending, active, expired, rejected
  isAdmin        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  payments       Payment[]
  notifications  Notification[]

  @@index([gradeId])
  @@index([status])
}

model Subject {
  id        String    @id @default(cuid())
  name      String
  icon      String?
  gradeId   Int
  sectionId String?
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  lectures  Lecture[]

  @@index([gradeId])
}

model Lecture {
  id          String    @id @default(cuid())
  subjectId   String
  title       String
  youtubeUrl  String
  pdfUrl      String?
  description String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId])
}

model Payment {
  id             String    @id @default(cuid())
  userId         String
  amount         Float
  screenshotUrl  String
  transactionRef String?
  status         String    @default("pending") // pending, approved, rejected
  reviewedBy     String?
  reviewNote     String?
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("sub") // super, sub
  permissions  String    @default("[]") // JSON string
  createdAt    DateTime  @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  lectureId String?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}